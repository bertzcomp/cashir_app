{
  "name": "kasir-alfamidi-prototype",
  "version": "1.0.0",
  "private": true,
  "description": "Prototype aplikasi kasir berbasis web yang sama untuk browser dan Android APK melalui Capacitor.",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "verify:dist": "node scripts/verify-dist.mjs",
    "test": "node --test tests/*.test.js",
    "cap:add:android": "cap add android",
    "cap:sync": "cap sync android",
    "android:debug": "npm run build && cap sync android && cd android && ./gradlew --no-daemon assembleDebug",
    "build:preview": "node scripts/build-preview.mjs"
  },
  "dependencies": {
    "@capacitor/core": "8.6.2"
  },
  "devDependencies": {
    "@capacitor/android": "8.6.2",
    "@capacitor/cli": "8.6.2",
    "vite": "8.3.8"
  },
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10.0.0"
  }
}
